---
# Production HAProxy Configuration Template
# ==========================================
#
# This is a TEMPLATE file for your private production configuration.
#
# INSTRUCTIONS:
# 1. Copy this file: cp production-secret.yaml.example production-secret.yaml
# 2. Update all placeholder values with your actual configuration
# 3. Store in a PRIVATE repository or encrypt with sealed-secrets/SOPS
# 4. DO NOT commit production-secret.yaml to public repos
#
# The production-secret.yaml file is already in .gitignore
#

---
# HAProxy Dataplane API Credentials
apiVersion: v1
kind: Secret
metadata:
  name: haproxy-api-credentials
  namespace: default
type: Opaque
stringData:
  username: admin
  password: "CHANGE_ME_SECURE_PASSWORD"

---
# Production HAProxy Configuration
apiVersion: v1
kind: Secret
metadata:
  name: haproxy-production-config
  namespace: default
  labels:
    haproxy.operator/config: "true"
    environment: production
type: Opaque
stringData:
  config.yaml: |
    apiConfig:
      # Your HAProxy Dataplane API endpoint
      url: http://YOUR_HAPROXY_IP:5555/v2
      secretRef: haproxy-api-credentials
      insecure: false

    # Backend server pools
    backends:
      # Admin/Management backends
      - name: admin-01
        mode: http
        balance:
          algorithm: roundrobin
        servers:
          - name: admin-01
            address: YOUR_ADMIN_IP_1
            port: 443
            ssl: true
            check: true
            verify: none

      - name: admin-02
        mode: http
        balance:
          algorithm: roundrobin
        servers:
          - name: admin-02
            address: YOUR_ADMIN_IP_2
            port: 443
            ssl: true
            check: true
            verify: none

      # Application cluster backends
      - name: cluster01
        mode: http
        balance:
          algorithm: source
        servers:
          - name: worker-01
            address: YOUR_WORKER_IP_1
            port: 443
            ssl: true
            check: true
            verify: none
          - name: worker-02
            address: YOUR_WORKER_IP_2
            port: 443
            ssl: true
            check: true
            verify: none
          - name: worker-03
            address: YOUR_WORKER_IP_3
            port: 443
            ssl: true
            check: true
            verify: none

      - name: cluster02
        mode: http
        balance:
          algorithm: source
        servers:
          - name: worker-04
            address: YOUR_WORKER_IP_4
            port: 443
            ssl: true
            check: true
            verify: none
          - name: worker-05
            address: YOUR_WORKER_IP_5
            port: 443
            ssl: true
            check: true
            verify: none

      # Legacy application backend
      - name: legacy-backend
        mode: http
        balance:
          algorithm: roundrobin
        servers:
          - name: legacy-server-01
            address: YOUR_LEGACY_IP_1
            port: 443
            ssl: true
            check: true
            verify: none
          - name: legacy-server-02
            address: YOUR_LEGACY_IP_2
            port: 443
            ssl: true
            check: true
            verify: none

      # Primary application backend (HTTPS)
      - name: primary-https
        mode: http
        balance:
          algorithm: roundrobin
        servers:
          - name: primary-01
            address: YOUR_PRIMARY_IP
            port: 443
            ssl: true
            check: true
            verify: none

      # Primary application backend (HTTP)
      - name: primary-http
        mode: http
        balance:
          algorithm: roundrobin
        servers:
          - name: primary-01
            address: YOUR_PRIMARY_IP
            port: 80
            check: true

      # Utility/control plane backend
      - name: utility-backend
        mode: http
        balance:
          algorithm: roundrobin
        servers:
          - name: utility-01
            address: YOUR_UTILITY_IP
            port: 4443
            ssl: true
            check: true
            verify: none

    # Frontend configurations
    frontends:
      # HTTP Frontend (Port 80)
      - name: http_frontend
        mode: http
        binds:
          - name: http
            address: "*"
            port: 80
        defaultBackend: primary-http
        acls:
          - name: is_secure_path
            criterion: path_beg
            value: /secure
          - name: is_admin_path
            criterion: path_beg
            value: /admin
          - name: is_legacy_app
            criterion: path_beg
            value: /legacy
        httpRequestRules:
          # Rate limiting (if using stick tables)
          - type: deny
            action: deny
            denyStatus: 429
            condition: if
            condTest: "{ sc_http_req_rate(0,ratelimit.agg) gt 100 }"
          - type: track-sc
            trackKey: src
            trackTable: ratelimit
            trackStickCounter: 0
          # Normalize host header
          - type: set-header
            hdrName: Host
            hdrFormat: "%[req.hdr(Host),lower]"
          # Redirect admin paths to HTTPS
          - type: redirect
            redirectType: location
            redirectValue: https://admin.YOUR_DOMAIN.com
            condition: if
            condTest: is_admin_path
          # Redirect all to HTTPS except specific paths
          - type: redirect
            redirectType: scheme
            redirectValue: https
            condition: if
            condTest: "!{ ssl_fc } !{ path_beg -i /public/health }"

      # HTTPS Frontend (Ports 443, 4443, 5000)
      - name: https_frontend
        mode: http
        binds:
          # Main HTTPS listener
          - name: https
            address: "*"
            port: 443
            ssl: true
            sslCertificate: /path/to/your/ssl/certificate.pem
            alpn: h2,http/1.1
          # Control plane listener
          - name: controlplane
            address: "*"
            port: 4443
            ssl: true
            sslCertificate: /path/to/your/ssl/certificate.pem
            verify: none
          # Container registry listener
          - name: registry
            address: "*"
            port: 5000
            ssl: true
            sslCertificate: /path/to/your/ssl/certificate.pem
            verify: none
        defaultBackend: cluster01
        acls:
          # Host-based ACLs
          - name: is_main_domain
            criterion: hdr(host)
            value: -i YOUR_DOMAIN.com
          - name: is_api_subdomain
            criterion: hdr(host)
            value: -i api.YOUR_DOMAIN.com
          - name: is_admin_subdomain
            criterion: hdr(host)
            value: -i admin.YOUR_DOMAIN.com
          - name: is_legacy_subdomain
            criterion: hdr(host)
            value: -i legacy.YOUR_DOMAIN.com
          - name: is_app1_subdomain
            criterion: hdr(host)
            value: -i app1.YOUR_DOMAIN.com
          - name: is_app2_subdomain
            criterion: hdr(host)
            value: -i app2.YOUR_DOMAIN.com
          - name: is_utility_subdomain
            criterion: hdr(host)
            value: -i utility.YOUR_DOMAIN.com
          # Regex-based ACLs
          - name: is_dynamic_subdomain
            criterion: hdr(host)
            value: "-m reg ^[a-z0-9-]+\\.apps\\.YOUR_DOMAIN\\.com$"
          - name: is_preview_subdomain
            criterion: hdr(host)
            value: "-m reg ^(?P<project>.+)\\.(preview)\\.YOUR_DOMAIN\\.com"
          # Path-based ACLs
          - name: is_api_path
            criterion: path_beg
            value: /api/v1
          - name: is_admin_path
            criterion: path_beg
            value: /admin
          - name: is_legacy_path
            criterion: path_beg
            value: /legacy
        httpRequestRules:
          # Path rewriting for API
          - type: set-header
            hdrName: Host
            hdrFormat: api.YOUR_DOMAIN.com
            condition: if
            condTest: is_api_path
          - type: set-path
            pathMatch: "^/api/v1/"
            pathFmt: "/"
            condition: if
            condTest: is_api_path
          # Normalize host header
          - type: set-header
            hdrName: Host
            hdrFormat: "%[req.hdr(Host),lower]"
          # Rate limiting
          - type: deny
            action: deny
            denyStatus: 429
            condition: if
            condTest: "{ sc_http_req_rate(0,ratelimit.agg) gt 100 }"
          - type: track-sc
            trackKey: src
            trackTable: ratelimit
            trackStickCounter: 0
          # Redirects
          - type: redirect
            redirectType: location
            redirectValue: https://new-location.YOUR_DOMAIN.com
            condition: if
            condTest: is_legacy_path
        useBackendRules:
          # Route to appropriate backends based on ACLs
          - name: primary-https
            condition: if
            condTest: is_main_domain !is_api_path
          - name: utility-backend
            condition: if
            condTest: is_utility_subdomain
          - name: cluster02
            condition: if
            condTest: is_preview_subdomain
          - name: cluster01
            condition: if
            condTest: is_dynamic_subdomain
          - name: admin-01
            condition: if
            condTest: is_admin_subdomain
          - name: legacy-backend
            condition: if
            condTest: is_legacy_subdomain
          - name: cluster01
            condition: if
            condTest: is_app1_subdomain
          - name: cluster01
            condition: if
            condTest: is_app2_subdomain
        httpResponseRules:
          # Security headers
          - type: set-header
            hdrName: Strict-Transport-Security
            hdrFormat: "max-age=31536000; includeSubDomains; preload"
          - type: set-header
            hdrName: X-Content-Type-Options
            hdrFormat: nosniff
          - type: set-header
            hdrName: X-Frame-Options
            hdrFormat: SAMEORIGIN

      # Metrics Frontend (internal only)
      - name: metrics
        mode: http
        binds:
          - name: metrics
            address: 127.0.0.1
            port: 8404
        defaultBackend: primary-http
